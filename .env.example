# App
PORT=3001
APP_URL=http://localhost:5173
NODE_ENV=development

# SQLite file. On a host with an ephemeral filesystem (Railway, Fly, Render),
# point this at a mounted volume or every deploy wipes bids, users and payments.
DB_PATH=./data/bidtop.db

# Cosmetic padding on the "online now / views so far" pill. The stored counters
# always hold real traffic; these only inflate what gets displayed.
# Set VIEWS_SEED=0, VIEWS_PER_HOUR=0 and LIVE_PAD_MAX=0 to show raw numbers.
VIEWS_SEED=1000
VIEWS_PER_HOUR=60
LIVE_PAD_MIN=6
LIVE_PAD_MAX=24

# Dodo Payments
# Leave blank to use the local mock checkout.
# Create a one-time product with Pay What You Want enabled (min $1).
# Today’s board starts at $2; a $5 floor will reject those checkouts.
# Test and live keys/products/webhooks are separate — do not mix them.
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
# Local: test_mode. The live site (gethigh.today) must use live_mode plus
# Live-dashboard keys — test keys return 401 on live.dodopayments.com.
DODO_PAYMENTS_ENV=test_mode

# DataFast
# The tracking SDK uses a public website ID (src/lib/datafast.ts).
# DATAFAST_API_KEY is a website key (df_...) from DataFast → Website
# Settings → API. The server uses it to read live visitors for /live.
# Never put this key in client code.
DATAFAST_API_KEY=
# Optional. Account tokens (dft_...) need a website. The server will look
# this up automatically; set it only if that lookup should be pinned.
DATAFAST_WEBSITE_ID=
# Calendar day for "today on /bike". Defaults to Asia/Kolkata.
DATAFAST_TIMEZONE=Asia/Kolkata
# Public DataFast share URL so /live can link out for credibility.
# Website Settings → General → Public Dashboard.
DATAFAST_PUBLIC_URL=https://datafa.st/share/6a90099434650f40287c17ab
# Dodo → Developer → Webhooks → Add endpoint → DataFast still needs that
# same website key pasted in Dodo, not in the browser.
